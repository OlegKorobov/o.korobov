  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: 
  Text:
    m_Untranslated: "In the <b>Build Profiles</b> window, select <b>Build</b>. \nA file explorer will open to choose where to save your build. \n\n<b>Tip:</b> Create a folder named \u201CWeb Builds\u201D to stay organized. \nOn Windows, the build name matches the folder name; on macOS, you must enter a name such as \u201C[YourProjectName] build 1.0\u201D. \n\nSelect <b>Select Folder</b> (macOS: <b>Save</b>). \n\nThe first build may take up to ten minutes, but later builds will be faster. \nWhen it finishes, the folder containing your build will appear."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items:
    - Type:
        m_TypeName: Unity.Tutorials.Editor.BuildStartedCriterion, Unity.Tutorials.Editor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null
      Criterion: {fileID: -640922871381874424}
