  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "Is the enemy Hoverbot where you want it to be?\n\nStep reminder:\n\n\u2022 Select the <b>Enemy_Hoverbot</b> in the Hierarchy or directly in the Scene view before selecting the Move Tool.\n\n\u2022 Use the arrows to reposition the enemy.\n\n\u2022 Similarly, you can rotate the Hoverbot with the <b>Rotate Tool</b> (shortcut <b>E</b>), or scale the Hoverbot using the <b>Scale Tool</b> (shortcut <b>R</b>)."
